HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS

# enable Tab completion menu
autoload -U compinit && compinit

# vim mode
bindkey -v
export KEYTIMEOUT=1

# Menu Completion + Vim hjkl
zmodload zsh/complist

# TUI menu
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Tab / Shift+Tab navigation in menu
bindkey -M menuselect '^I' menu-complete
bindkey -M menuselect '^[[Z' reverse-menu-complete

# Vim motion in menu navigation
bindkey -M menuselect 'h' backward-char
bindkey -M menuselect 'j' down-line-or-history
bindkey -M menuselect 'k' up-line-or-history
bindkey -M menuselect 'l' forward-char
bindkey -M menuselect '0' beginning-of-line
bindkey -M menuselect '$' end-of-line
bindkey -M menuselect '^M' accept-line

# auto detect plugin installation over distros
source_first_found() {
    for file in "$@"; do
        if [ -f "$file" ]; then
            source "$file"
            return 0
        fi
    done
    return 1
}

# zsh-autosuggestions
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
source_first_found \
    "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "/usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "/usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
bindkey '^[OC' forward-char
bindkey '^F' forward-char

# zsh-syntax-highlighting
source_first_found \
    "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "/usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
    "/usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# zsh-history-substring-search
if source_first_found \
    "$HOME/.zsh/zsh-history-substring-search/zsh-history-substring-search.zsh" \
    "/usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh" \
    "/usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh"; then
    # 绑定上下方向键，以及 Vim 模式下的 k/j 进行历史搜索
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
    bindkey -M vicmd 'k' history-substring-search-up
    bindkey -M vicmd 'j' history-substring-search-down
fi

# Cross-distro command-not-found handler
if [ -x "/usr/libexec/pk-command-not-found" ]; then
    # Fedora / RHEL (PackageKit)
    command_not_found_handler() {
        /usr/libexec/pk-command-not-found "$@"
    }
    # 兼容部分将 handle 映射到 handler 的脚本或 Bash 移植习惯
    command_not_found_handle() {
        command_not_found_handler "$@"
    }
elif [ -f "/usr/share/doc/pkgfile/command-not-found.zsh" ]; then
    # Arch / CachyOS (pkgfile)
    source "/usr/share/doc/pkgfile/command-not-found.zsh"
elif [ -f "/etc/zsh_command_not_found" ]; then
    # Debian / Ubuntu
    source "/etc/zsh_command_not_found"
fi

# load shell config
SHELL_CONFIG_DIR="$HOME/dotfiles/shell_config"
if [ -d "$SHELL_CONFIG_DIR" ]; then
    for file in "$SHELL_CONFIG_DIR"/*.sh; do
        source "$file"
    done
fi
. "$HOME/.local/bin/env"
